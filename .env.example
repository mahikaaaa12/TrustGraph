# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/trustgraph

# Authentication (JSON Web Token)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters
JWT_EXPIRES_IN=1d

# Allowed Cross-Origin Origins
CLIENT_ORIGIN=http://localhost:5173

# Meta / Instagram Graph API Configuration
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/v1/instagram/oauth/callback
INSTAGRAM_API_VERSION=v19.0
INSTAGRAM_TOKEN_SECRET=at_least_32_chars_random_string_for_token_encryption

# Optional LLM / Threat Intelligence Providers (Graceful Fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_optional_for_generative_explanations
VIRUSTOTAL_API_KEY=your_virustotal_api_key_optional

# Telemetry & Model Monitoring
ML_MONITORING_WINDOW_SIZE=2000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
